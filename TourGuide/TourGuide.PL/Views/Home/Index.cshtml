@model TourGuide.BLL.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home - Discover Egypt Your Way";
}

<link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />

<!-- ==========================================
     HERO SECTION
     ========================================== -->
<section class="home-hero">
    <div class="hero-inner">
        <div class="hero-content">
            <h1 class="hero-title">
                Discover The World
                <span class="highlight">Here Your Way.</span>
            </h1>
            <p class="hero-description">
                Tours, experiences and custom Egypt trips designed by local experts. Immerse yourself in ancient wonders and vibrant culture with personalized itineraries.
            </p>
            <div class="hero-actions">
                <a href="#featured-tours" class="btn-primary-tour">
                    Explore Tours
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
                <a asp-controller="Guides" asp-action="Index" class="btn-secondary-tour">
                    Plan My Trip
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================
     PROMISE / WHY TRAVEL WITH US SECTION
     ========================================== -->
<section class="features-section">
    <div class="section-container">
        <div class="section-header-center">
            <span class="eyebrow-text">THE TOURGUIDE PROMISE</span>
            <h2 class="section-title">Why Travel With Us</h2>
            <p class="section-subtitle">
                We combine local insider knowledge with world-class hospitality to craft unforgettable journeys.
            </p>
        </div>

        <div class="features-grid">
            <!-- Feature 1 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                </div>
                <h3 class="feature-card-title">Expert Local Guides</h3>
                <p class="feature-card-description">
                    Certified Egyptologists and native guides who bring thousands of years of history to life with captivating stories.
                </p>
            </div>

            <!-- Feature 2 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="21" x2="4" y2="14"></line>
                        <line x1="4" y1="10" x2="4" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12" y2="3"></line>
                        <line x1="20" y1="21" x2="20" y2="16"></line>
                        <line x1="20" y1="12" x2="20" y2="3"></line>
                        <line x1="1" y1="14" x2="7" y2="14"></line>
                        <line x1="9" y1="8" x2="15" y2="8"></line>
                        <line x1="17" y1="16" x2="23" y2="16"></line>
                    </svg>
                </div>
                <h3 class="feature-card-title">100% Customizable</h3>
                <p class="feature-card-description">
                    Tailor every moment to your preferences. Adjust pace, add private felucca rides, or extend your stay in luxury desert camps.
                </p>
            </div>

            <!-- Feature 3 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                        <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                    </svg>
                </div>
                <h3 class="feature-card-title">24/7 Concierge Support</h3>
                <p class="feature-card-description">
                    From airport pickups to last-minute restaurant reservations, our dedicated local team is with you around the clock.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================
     FEATURED TOURS SECTION
     ========================================== -->
<section id="featured-tours" class="tours-section">
    <div class="section-container">
        <div class="tours-header-row">
            <div>
                <span class="eyebrow-text">HANDPICKED ADVENTURES</span>
                <h2 class="section-title">Featured Tours</h2>
            </div>
            <a asp-controller="Guides" asp-action="Index" class="view-all-link">
                View all @Model.TotalToursCount tours
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>

        <div class="tours-grid">
            @foreach (var tour in Model.FeaturedTours)
            {
                <div class="tour-card">
                    <div class="tour-image-container">
                        <img src="@tour.ImageUrl" alt="@tour.Title" class="tour-image" />
                        
                        <div class="tour-rating-badge">
                            <span class="star-icon">★</span>
                            <span>@tour.AverageRating.ToString("0.0")</span>
                            <span style="color: #64748b;">(@tour.ReviewCount)</span>
                        </div>

                        <div class="tour-duration-badge">
                            @tour.DurationDays @(tour.DurationDays > 1 ? "Days" : "Day")
                        </div>
                    </div>

                    <div class="tour-content">
                        <div class="tour-location">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>@tour.Location</span>
                        </div>

                        <h3 class="tour-title">@tour.Title</h3>

                        <div class="tour-footer">
                            <div class="tour-price-box">
                                <span class="price-label">From</span>
                                <div class="price-value-row">
                                    <span class="price-amount">$@tour.PricePerPerson.ToString("0")</span>
                                    <span class="price-unit">/ person</span>
                                </div>
                            </div>
                            <a asp-controller="Guides" asp-action="Index" class="btn-view-tour">
                                View Tour
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
