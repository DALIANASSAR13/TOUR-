@model TourGuide.PL.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<link rel="stylesheet" href="~/css/Account/Login.css" asp-append-version="true" />

<section class="auth-page">
    <div class="auth-wrap">
        <div class="auth-card auth-card-narrow">
            <h1 class="auth-title text-center">Welcome back</h1>
            <p class="auth-subtitle text-center">One login for travelers, guides and admins.</p>

            @if (TempData["AccountMessage"] is string accountMessage)
            {
                <div class="auth-success" role="status">@accountMessage</div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <label class="auth-label" asp-for="Email">Email</label>
                <input asp-for="Email" class="auth-input" autocomplete="email" />
                <span asp-validation-for="Email"></span>

                <label class="auth-label" asp-for="Password">Password</label>
                <input asp-for="Password" class="auth-input" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>

                <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

                <label class="auth-check">
                    <input asp-for="RememberMe" type="checkbox" /> Keep me logged in
                </label>

                <button type="submit" class="auth-btn">Log in</button>
            </form>

            <p class="auth-foot">New here? <a asp-controller="Account" asp-action="Register">Create an account</a></p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}