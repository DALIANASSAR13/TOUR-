@{
    ViewData["Title"] = "Access denied";
}

<link rel="stylesheet" href="~/css/Account/Login.css" asp-append-version="true" />

<section class="auth-page">
    <div class="auth-wrap">
        <div class="auth-card auth-card-narrow text-center">
            <h1 class="auth-title">Access denied</h1>
            <p class="auth-subtitle">Your account cannot open this page. Use the menu to go to the pages for your role.</p>
            <a class="auth-btn auth-btn-inline" asp-area="" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>
    </div>
</section>
