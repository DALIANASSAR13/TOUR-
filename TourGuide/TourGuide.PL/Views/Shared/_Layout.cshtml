@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TourGuide</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TourGuide.PL.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span style="color: #0b6a8a; font-family: 'Playfair Display', Georgia, serif; font-size: 1.6rem;">TourGuide</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark px-3" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated != true || User.IsInRole(TourGuide.DAL.Constants.Roles.Tourist))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-medium text-dark px-3" asp-area="" asp-controller="Search" asp-action="Index">Find Guides</a>
                            </li>
                        }
                        @if (User.IsInRole(TourGuide.DAL.Constants.Roles.Tourist))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-medium text-dark px-3" asp-area="Tourist" asp-controller="Bookings" asp-action="Index">My Bookings</a>
                            </li>
                        }
                        @if (User.IsInRole(TourGuide.DAL.Constants.Roles.Guide))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-medium text-dark px-3" asp-area="Guide" asp-controller="BookingRequests" asp-action="Index">Requests</a>
                            </li>
                        }
                        @if (User.IsInRole(TourGuide.DAL.Constants.Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-medium text-dark px-3" asp-area="Admin" asp-controller="Admin" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-muted small">@User.Identity.Name</span>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-outline-secondary fw-semibold px-3 py-2" style="border-radius: 8px;">Log out</button>
                            </form>
                        }
                        else
                        {
                            <a class="nav-link fw-medium text-dark px-2" asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn text-white fw-semibold px-4 py-2" style="background-color: #0b6a8a; border-radius: 8px;" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(TourGuide.DAL.Constants.Roles.Admin))
                            {
                                <a asp-area="Admin"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Admin Dashboard
                                </a>
                            }

                            @if (User.IsInRole(TourGuide.DAL.Constants.Roles.Guide))
                            {
                           
                                <a class="btn text-white fw-semibold px-4 py-2" style="background-color: #0b6a8a; border-radius: 6px;" asp-area="Guide" asp-controller="BookingRequests" asp-action="Index">
                                    View Booking Requests
                                </a>
                            }

                            @if (User.IsInRole(TourGuide.DAL.Constants.Roles.Tourist))
                            {
                                
							<a class="btn text-white fw-semibold px-4 py-2" style="background-color: #0b6a8a; border-radius: 6px;" asp-area="Tourist" asp-controller="Bookings" asp-action="Index">
								My Bookings
                                </a>
                            }
                        }
                        
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer bg-white border-top py-4 mt-auto">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 text-muted">
                <div>
                    <span class="fw-semibold text-dark">TourGuide</span> &copy; 2026. Handcrafted travel experiences across Egypt.
                </div>
                <div class="d-flex gap-4">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a>
                    <a asp-area="" asp-controller="Search" asp-action="Index" class="text-decoration-none text-muted">Guides</a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Privacy Policy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
