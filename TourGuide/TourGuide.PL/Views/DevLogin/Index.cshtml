@model IEnumerable<TourGuide.PL.ViewModels.DevLoginUserViewModel>
@{
    ViewData["Title"] = "Dev login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<section class="container py-5" style="max-width: 820px;">
    <h1 class="mb-1">Dev login</h1>
    <p class="text-muted">Development only. Sign in as a demo user to test pages before real login (Cycle 1.1.a). Password for all: see <code>Seed:DemoPassword</code>.</p>

    @if (TempData["DevLoginError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center">
            <span>Signed in as <strong>@User.Identity.Name</strong></span>
            <form asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
            </form>
        </div>
    }

    <table class="table align-middle">
        <thead>
            <tr><th>User</th><th>Role</th><th>Data</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td><strong>@u.Name</strong><br /><small class="text-muted">@u.Email</small></td>
                    <td>@u.Role</td>
                    <td><small>@u.Note</small></td>
                    <td class="text-end">
                        <form asp-action="As" method="post" class="m-0">
                            <input type="hidden" name="email" value="@u.Email" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-sm text-white" style="background:#0b6a8a;">Log in as</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2 class="h5 mt-4">Pages to test</h2>
    <ul>
        <li><a asp-area="Tourist" asp-controller="Bookings" asp-action="Index">/Tourist/Bookings</a> — My Bookings (Cycle 2.8.a), tourists only</li>
    </ul>
</section>
