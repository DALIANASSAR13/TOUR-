@model TourGuide.PL.ViewModels.GuideStatusViewModel
@using TourGuide.DAL.Enums
@{
    ViewData["Title"] = "Verification Status";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Guide/GuideArea.css" asp-append-version="true" />
}

<section class="guide-section">
    <div class="tg-container" style="max-width: 740px;">
        <div class="mb-4">
            <h1 class="tg-page-title">Account Verification Status</h1>
            <p class="tg-page-subtitle mb-0">Track the review progress of your tour guide application and documents.</p>
        </div>

        @if (TempData["ReapplySuccess"] is string successMsg)
        {
            <div class="tg-banner tg-banner-success mb-4" role="status">
                <span>&#10003; @successMsg</span>
            </div>
        }

        <div class="tg-card">
            @if (Model.Status == VerificationStatus.Pending)
            {
                <div class="mb-3">
                    <span class="tg-badge tg-badge-pending px-3 py-2">Pending Review</span>
                </div>

                <h2 class="tg-section-title mb-2">Your application is under review</h2>
                <p class="text-muted mb-4">
                    Our verification team is currently reviewing your uploaded documents (government ID, proof of residence, and criminal record certificate).
                    You will gain full access to your guide profile and booking requests once your account is approved.
                </p>

                <div class="p-3 rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-2" style="background-color: var(--tg-bg);">
                    <span class="text-muted small">Submitted on (UTC)</span>
                    <span class="fw-semibold small">@Model.SubmittedAtUtc.ToString("MMM d, yyyy 'at' HH:mm") UTC</span>
                </div>
            }
            else if (Model.Status == VerificationStatus.Rejected)
            {
                <div class="mb-3">
                    <span class="tg-badge tg-badge-rejected px-3 py-2">Application Rejected</span>
                </div>

                <h2 class="tg-section-title mb-2">Your verification application was not approved</h2>
                <p class="text-muted mb-3">
                    Please review the feedback from our verification team below before submitting updated documents.
                </p>

                <div class="tg-banner tg-banner-danger mb-4" role="alert">
                    <div>
                        <div class="fw-semibold mb-1">Reason for rejection</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.RejectionReason) ? "No specific reason was provided." : Model.RejectionReason)</div>
                    </div>
                </div>

                <div class="p-3 rounded-3 border d-flex flex-column gap-2 mb-4" style="background-color: var(--tg-bg);">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Submitted on (UTC)</span>
                        <span class="fw-medium small">@Model.SubmittedAtUtc.ToString("MMM d, yyyy 'at' HH:mm") UTC</span>
                    </div>
                    @if (Model.ReviewedAtUtc.HasValue)
                    {
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Reviewed on (UTC)</span>
                            <span class="fw-medium small">@Model.ReviewedAtUtc.Value.ToString("MMM d, yyyy 'at' HH:mm") UTC</span>
                        </div>
                    }
                </div>

                <div>
                    <a asp-area="Guide" asp-controller="Verification" asp-action="Reapply" class="btn btn-tg-primary px-4">
                        Upload new documents &amp; re-apply
                    </a>
                </div>
            }
            else if (Model.Status == VerificationStatus.Approved)
            {
                <div class="mb-3">
                    <span class="tg-badge tg-badge-approved px-3 py-2">&#10003; Verified guide</span>
                </div>

                <h2 class="tg-section-title mb-2">You are a verified Tourguide!</h2>
                <p class="text-muted mb-4">
                    Your documents have been verified.
                    @if (!Model.IsProfileComplete)
                    {
                        <span class="fw-semibold text-dark">Complete your public profile (city, rate, languages, and specializations) so travelers can find and book you.</span>
                    }
                    else
                    {
                        <span>Your profile is complete and visible in search results.</span>
                    }
                </p>

                <div class="p-3 rounded-3 border d-flex flex-column gap-2 mb-4" style="background-color: var(--tg-bg);">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Submitted on (UTC)</span>
                        <span class="fw-medium small">@Model.SubmittedAtUtc.ToString("MMM d, yyyy 'at' HH:mm") UTC</span>
                    </div>
                    @if (Model.ReviewedAtUtc.HasValue)
                    {
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Approved on (UTC)</span>
                            <span class="fw-medium small">@Model.ReviewedAtUtc.Value.ToString("MMM d, yyyy 'at' HH:mm") UTC</span>
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-area="Guide" asp-controller="Profile" asp-action="Edit" class="btn btn-tg-primary px-4">
                        @(Model.IsProfileComplete ? "Edit my profile" : "Complete my profile")
                    </a>
                    <a asp-area="Guide" asp-controller="BookingRequests" asp-action="Index" class="btn btn-tg-secondary px-4">
                        View booking requests
                    </a>
                </div>
            }
        </div>
    </div>
</section>