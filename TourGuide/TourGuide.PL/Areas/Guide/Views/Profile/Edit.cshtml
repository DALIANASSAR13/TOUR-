@model TourGuide.PL.ViewModels.EditGuideProfileViewModel
@{
    ViewData["Title"] = "Edit My Profile";
}

<section class="container py-5" style="max-width: 860px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1" style="font-family: 'Playfair Display', Georgia, serif; color: #0b6a8a;">Edit Guide Profile</h1>
            <p class="text-muted mb-0">Keep your public details, rates, languages, and specializations up to date.</p>
        </div>
        @if (Model.IsBookable)
        {
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                ✓ Profile Complete &amp; Bookable
            </span>
        }
        else
        {
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
                Incomplete Profile (Not Bookable Yet)
            </span>
        }
    </div>

    @if (TempData["ProfileSuccess"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            @* ===== Profile Photo ===== *@
            <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-4 pb-4 mb-4 border-bottom">
                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentPhotoFileName))
                    {
                        <img src="@Url.Action("Photo", "Profile", new { area = "Guide", fileName = Model.CurrentPhotoFileName })"
                             alt="Guide profile photo"
                             class="rounded-circle object-fit-cover border"
                             style="width: 96px; height: 96px;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-muted fw-semibold"
                             style="width: 96px; height: 96px; font-size: 1.5rem;">
                            @(string.IsNullOrWhiteSpace(Model.FullName) ? "G" : Model.FullName[0].ToString().ToUpper())
                        </div>
                    }
                </div>
                <div class="flex-grow-1">
                    <label asp-for="Photo" class="form-label fw-semibold"></label>
                    <input asp-for="Photo" type="file" accept="image/jpeg,image/png" class="form-control" />
                    <span asp-validation-for="Photo" class="text-danger small"></span>
                    <div class="form-text">Upload a clear headshot (JPG or PNG, max 5 MB).</div>
                </div>
            </div>

            @* ===== Personal & Location Details ===== *@
            <h2 class="h5 mb-3 fw-semibold">Basic Information</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-medium"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-medium"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="+20 100 000 0000" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CountryCode" class="form-label fw-medium"></label>
                    <select asp-for="CountryCode" asp-items="Model.Countries" class="form-select">
                        <option value="">-- Select Country --</option>
                    </select>
                    <span asp-validation-for="CountryCode" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="City" class="form-label fw-medium"></label>
                    <input asp-for="City" class="form-control" placeholder="e.g. Cairo, Luxor, Giza" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="TimeZoneId" class="form-label fw-medium"></label>
                    <select asp-for="TimeZoneId" asp-items="Model.TimeZones" class="form-select">
                        <option value="">-- Select Time Zone --</option>
                    </select>
                    <span asp-validation-for="TimeZoneId" class="text-danger small"></span>
                </div>
            </div>

            @* ===== Rates & Experience ===== *@
            <h2 class="h5 mb-3 fw-semibold">Rates &amp; Experience</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="PricePerHour" class="form-label fw-medium"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PricePerHour" type="number" step="0.01" min="1" class="form-control" />
                    </div>
                    <span asp-validation-for="PricePerHour" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="YearsOfExperience" class="form-label fw-medium"></label>
                    <input asp-for="YearsOfExperience" type="number" min="0" max="60" class="form-control" />
                    <span asp-validation-for="YearsOfExperience" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Bio" class="form-label fw-medium"></label>
                    <textarea asp-for="Bio" rows="4" class="form-control" placeholder="Tell tourists about your background, guiding style, and favorite places..."></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>
            </div>

            @* ===== Languages & Specializations ===== *@
            <h2 class="h5 mb-3 fw-semibold">Languages &amp; Specializations</h2>
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-medium d-block">Languages Spoken <span class="text-danger">*</span></label>
                    <div class="border rounded p-3 bg-light-subtle" style="max-height: 220px; overflow-y: auto;">
                        @foreach (var lang in Model.AvailableLanguages)
                        {
                            var isChecked = Model.LanguageIds.Contains(lang.Id);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="LanguageIds" value="@lang.Id" id="lang_@lang.Id" @(isChecked ? "checked" : null) />
                                <label class="form-check-label" for="lang_@lang.Id">@lang.Name</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="LanguageIds" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-medium d-block">Specializations <span class="text-danger">*</span></label>
                    <div class="border rounded p-3 bg-light-subtle" style="max-height: 220px; overflow-y: auto;">
                        @foreach (var spec in Model.AvailableSpecializations)
                        {
                            var isChecked = Model.SpecializationIds.Contains(spec.Id);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SpecializationIds" value="@spec.Id" id="spec_@spec.Id" @(isChecked ? "checked" : null) />
                                <label class="form-check-label" for="spec_@spec.Id">@spec.Name</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="SpecializationIds" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-area="Guide" asp-controller="BookingRequests" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn text-white fw-semibold px-4" style="background-color: #0b6a8a;">
                    Save Changes
                </button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}