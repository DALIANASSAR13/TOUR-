@model TourGuide.PL.ViewModels.EditGuideProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Guides/GuideArea.css" asp-append-version="true" />
}

<section class="guide-section">
    <div class="tg-container">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h1 class="tg-page-title">My Profile</h1>
                <p class="tg-page-subtitle mb-0">This is what travelers see when they find you.</p>
            </div>
            @if (Model.IsBookable)
            {
                <span class="tg-badge tg-badge-approved px-3 py-2">&#10003; Profile Complete &amp; Bookable</span>
            }
            else
            {
                <span class="tg-badge tg-badge-pending px-3 py-2">Incomplete Profile (Not Bookable Yet)</span>
            }
        </div>

        @if (TempData["ProfileSuccess"] is string successMsg)
        {
            <div class="tg-banner tg-banner-success mb-4" role="status">
                <span>&#10003; @successMsg</span>
            </div>
        }

        <div class="profile-edit-grid">
            <!-- Left Column: Main Profile Form -->
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="tg-card">
                <div asp-validation-summary="ModelOnly" class="tg-banner tg-banner-danger mb-4"></div>

                <!-- Profile Photo -->
                <div class="d-flex flex-wrap align-items-center gap-4 pb-4 mb-4 border-bottom">
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentPhotoFileName))
                    {
                        <img id="photoPreviewImg"
                             src="@Url.Action("Photo", "Profile", new { area = "Guide", fileName = Model.CurrentPhotoFileName })"
                             alt="Guide profile photo"
                             class="profile-photo-preview border" />
                    }
                    else
                    {
                        <div id="photoPreviewFallback" class="profile-photo-preview fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.FullName) ? "Photo" : Model.FullName[0].ToString().ToUpper())
                        </div>
                        <img id="photoPreviewImg" src="" alt="Preview" class="profile-photo-preview border d-none" />
                    }

                    <div>
                        <label for="Photo" class="btn btn-tg-secondary mb-2" style="cursor: pointer;">
                            Change photo
                        </label>
                        <input asp-for="Photo" type="file" accept="image/jpeg,image/png" class="d-none" id="Photo" />
                        <div class="text-muted small">JPG or PNG, square works best (max 5 MB).</div>
                        <span asp-validation-for="Photo"></span>
                    </div>
                </div>

                <!-- Basic & Location Info -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="tg-label">Full name</label>
                        <input asp-for="FullName" class="form-control tg-input" />
                        <span asp-validation-for="FullName"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="tg-label">Phone number</label>
                        <input asp-for="PhoneNumber" class="form-control tg-input" placeholder="+20 100 000 0000" />
                        <span asp-validation-for="PhoneNumber"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CountryCode" class="tg-label">Country</label>
                        <select asp-for="CountryCode" asp-items="Model.Countries" class="form-select tg-input">
                            <option value="">Select country</option>
                        </select>
                        <span asp-validation-for="CountryCode"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="City" class="tg-label">City</label>
                        <input asp-for="City" class="form-control tg-input" placeholder="e.g. Giza, Cairo" />
                        <span asp-validation-for="City"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PricePerHour" class="tg-label">Price per hour (USD)</label>
                        <input asp-for="PricePerHour" type="number" step="0.01" min="1" class="form-control tg-input" />
                        <div class="text-muted" style="font-size: 0.76rem; margin-top: 0.25rem;">New price applies to new requests only.</div>
                        <span asp-validation-for="PricePerHour"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="YearsOfExperience" class="tg-label">Years of experience</label>
                        <input asp-for="YearsOfExperience" type="number" min="0" max="60" class="form-control tg-input" />
                        <span asp-validation-for="YearsOfExperience"></span>
                    </div>

                    <div class="col-md-7">
                        <label asp-for="TimeZoneId" class="tg-label">Time zone</label>
                        <select asp-for="TimeZoneId" asp-items="Model.TimeZones" class="form-select tg-input">
                            <option value="">Select time zone</option>
                        </select>
                        <span asp-validation-for="TimeZoneId"></span>
                    </div>
                </div>

                <!-- Languages Pills -->
                <div class="mb-4">
                    <label class="tg-label mb-2">Languages <span class="text-danger">*</span></label>
                    <div class="tg-chip-group">
                        @foreach (var lang in Model.AvailableLanguages)
                        {
                            var isChecked = Model.LanguageIds.Contains(lang.Id);
                            <div>
                                <input class="tg-chip-checkbox" type="checkbox" name="LanguageIds" value="@lang.Id" id="lang_@lang.Id" @(isChecked ? "checked" : null) />
                                <label class="tg-chip-label" for="lang_@lang.Id">@lang.Name</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="LanguageIds"></span>
                </div>

                <!-- Specializations Pills -->
                <div class="mb-4">
                    <label class="tg-label mb-2">Specializations <span class="text-danger">*</span></label>
                    <div class="tg-chip-group">
                        @foreach (var spec in Model.AvailableSpecializations)
                        {
                            var isChecked = Model.SpecializationIds.Contains(spec.Id);
                            <div>
                                <input class="tg-chip-checkbox" type="checkbox" name="SpecializationIds" value="@spec.Id" id="spec_@spec.Id" @(isChecked ? "checked" : null) />
                                <label class="tg-chip-label" for="spec_@spec.Id">@spec.Name</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="SpecializationIds"></span>
                </div>

                <!-- Short Bio -->
                <div class="mb-4">
                    <label asp-for="Bio" class="tg-label">Short bio</label>
                    <textarea asp-for="Bio" id="bioTextarea" rows="4" maxlength="500" class="form-control tg-input"
                              placeholder="Tell travelers about your background, guiding style, and favorite places..."></textarea>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span asp-validation-for="Bio"></span>
                        <span id="bioCounter" class="text-muted small ms-auto">@(Model.Bio?.Length ?? 0) / 500</span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-area="Guide" asp-controller="BookingRequests" asp-action="Index" class="btn btn-tg-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-tg-primary px-4">Save profile</button>
                </div>
            </form>

            <!-- Right Column: Verification & Status Cards -->
            <aside class="d-flex flex-column gap-3">
                <div class="tg-card tg-card-sm">
                    <h2 class="tg-section-title mb-2" style="font-size: 1.05rem;">Verification</h2>
                    <span class="tg-badge tg-badge-approved mb-2">Approved</span>
                    <p class="text-muted small mb-0">
                        Your documents are verified and are only visible to our admins.
                    </p>
                </div>

                <div class="tg-card tg-card-sm">
                    <h2 class="tg-section-title mb-2" style="font-size: 1.05rem;">Booking readiness</h2>
                    @if (Model.IsBookable)
                    {
                        <p class="text-muted small mb-0">
                            Your profile is complete and visible in search results. Travelers can send you booking requests.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            Fill in all required fields (city, photo, rate, at least one language and specialization, and bio) to appear in search.
                        </p>
                    }
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const fileInput = document.getElementById('Photo');
            const previewImg = document.getElementById('photoPreviewImg');
            const fallback = document.getElementById('photoPreviewFallback');

            if (fileInput && previewImg) {
                fileInput.addEventListener('change', function () {
                    const file = this.files && this.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        previewImg.classList.remove('d-none');
                        if (fallback) fallback.classList.add('d-none');
                    };
                    reader.readAsDataURL(file);
                });
            }

            const bio = document.getElementById('bioTextarea');
            const counter = document.getElementById('bioCounter');
            if (bio && counter) {
                bio.addEventListener('input', function () {
                    counter.textContent = bio.value.length + ' / 500';
                });
            }
        })();
    </script>
}